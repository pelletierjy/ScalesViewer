# Runtime API keys for the AI homework tutor widget.
# These are injected by the host page (ScalesViewer) at runtime via
# attributes on <need-homework-app> so they are NOT baked into the widget bundle.
#
# Copy this file to .env.local and fill in your keys.
# In production, set these as environment variables in your deployment platform
# (e.g. Vercel, GitHub Actions secrets, etc.).

NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GROQ_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=

# Firebase config as a single JSON string, e.g.:
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
NEXT_PUBLIC_FIREBASE_CONFIG=
