{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScalesViewer",
  "version": "0.1.0",
  "identifier": "com.jeanyves.scalesviewer",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm exec next dev --turbopack -p 3001",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ScalesViewer",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
